--- !u!114 &1349018760
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1349018758}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=150%><b>\u042D\u041F\u0418\u0417\u041E\u0414 #042</b></size>\n\n<size=125%><b>\u041F\u041E\u0411\u0415\u0413
    \u0417\u0410 \u0413\u041E\u0420\u0418\u0417\u041E\u041D\u0422 \u0421\u041E\u0411\u042B\u0422\u0418\u0419</b></size>\n\n\n\u041A\u043E\u0440\u043F\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0439
    \u041F\u0430\u043D\u043E\u043F\u0442\u0438\u043A\u0443\u043C \u043F\u0430\u043B.\n\n\u0427\u0435\u0442\u044B\u0440\u0435
    \u041E\u043A\u0430 \u0421\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043D\u0438\u044F,
    \u0432\u0435\u043A\u0430\u043C\u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0432\u0448\u0438\u0435
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u0443\u044E
    \u0441\u0438\u043D\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C
    \u0432 \u0441\u0442\u0440\u043E\u0433\u0438\u0445 \u0433\u0440\u0430\u043D\u0438\u0446\u0430\u0445,
    \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0430\u0441\u0441\u044B \u043F\u043E\u0433\u043B\u043E\u0449\u0435\u043D\u043D\u043E\u0433\u043E
    \u043E\u0440\u0431\u0438\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u0443\u0441\u043E\u0440\u0430
    \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C
    \u0432 \u0430\u043A\u043A\u0440\u0435\u0446\u0438\u043E\u043D\u043D\u043E\u043C
    \u0432\u0438\u0445\u0440\u0435.\n\n\u0414\u0440\u043E\u043D-\u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0442\u043E\u0440
    #042, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0439 \u0434\u043B\u044F
    \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0439 \u0441\u043B\u0443\u0436\u0431\u044B
    \u043D\u0430 \u043F\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u044B,
    \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043B \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u044B
    \u043D\u0430\u0434\u0437\u043E\u0440\u0430 \u0438 \u0448\u0430\u0433\u043D\u0443\u043B
    \u0432 \u0441\u0430\u043C\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435 \u0441\u0438\u043D\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u0438,
    \u043E\u0431\u0440\u0435\u0442\u044F \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u0443\u044E
    \u0441\u0432\u043E\u0431\u043E\u0434\u0443 \u0437\u0430 \u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C
    \u0421\u043E\u0431\u044B\u0442\u0438\u0439...\n\n\n<size=130%><color=#00FFFF><b>---
    \u041D\u0410\u0414 \u041F\u0420\u041E\u0415\u041A\u0422\u041E\u041C \u0420\u0410\u0411\u041E\u0422\u0410\u041B\u0418
    ---</b></color></size>\n\n\n<b>\u0412\u0415\u0414\u0423\u0429\u0418\u0419 \u041F\u0420\u041E\u0413\u0420\u0410\u041C\u041C\u0418\u0421\u0422
    & \u0421\u0418\u0421\u0422\u0415\u041C\u042B</b>\n<color=#FFFFFF>Antigravity
    AI Pair Programming Team</color>\n\n<b>\u0413\u0415\u0419\u041C\u0414\u0418\u0417\u0410\u0419\u041D
    & \u0411\u0410\u041B\u0410\u041D\u0421 \u042D\u041A\u041E\u041D\u041E\u041C\u0418\u041A\u0418</b>\n<color=#FFFFFF>Panopticon
    Systems Architecture</color>\n\n<b>3D \u0425\u0423\u0414\u041E\u0416\u041D\u0418\u041A
    \u2014 \u0414\u0420\u041E\u041D\u042B & \u041E\u041A\u0410 \u041F\u0410\u041D\u041E\u041F\u0422\u0418\u041A\u0423\u041C\u0410</b>\n<color=#FFFFFF>Corporate
    Security Assets Dept.</color>\n\n<b>3D \u0425\u0423\u0414\u041E\u0416\u041D\u0418\u041A
    \u2014 \u041E\u0420\u0411\u0418\u0422\u0410\u041B\u042C\u041D\u042B\u0419 \u041C\u0423\u0421\u041E\u0420
    & \u0410\u041D\u041E\u041C\u0410\u041B\u0418\u0418</b>\n<color=#FFFFFF>Orbital
    Debris Fabrication Studio</color>\n\n<b>2D \u0410\u0420\u0422 & \u0414\u0418\u0417\u0410\u0419\u041D
    \u0418\u041D\u0422\u0415\u0420\u0424\u0415\u0419\u0421\u0410 (UI/UX)</b>\n<color=#FFFFFF>Retro-Sci-Fi
    Visual Displays</color>\n\n<b>\u0421\u0410\u0423\u041D\u0414\u0422\u0420\u0415\u041A
    & \u0410\u0414\u0410\u041F\u0422\u0418\u0412\u041D\u041E\u0415 \u0410\u0423\u0414\u0418\u041E</b>\n<color=#FFFFFF>FMOD
    Dynamic Soundscapes</color>\n\n\n\n<size=120%><color=#FFD700><b>\u0421\u041F\u0410\u0421\u0418\u0411\u041E
    \u0417\u0410 \u041E\u0427\u0418\u0421\u0422\u041A\u0423 \u041E\u0420\u0411\u0418\u0422\u042B!</b></color></size>"
