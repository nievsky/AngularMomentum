MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5b67eb6f0899434fbf84a340b9975af, type: 3}
  m_Name: NarrativeDialogueConfig
  m_EditorClassIdentifier: Assembly-CSharp::OrbitalPanopticon.Core.NarrativeDialogueConfigSO
  stage1Start:
    speakerName: "\u041A\u041E\u0420\u041F\u041E\u0420\u0410\u0422\u0418\u0412\u041D\u042B\u0419
      \u041A\u0423\u0420\u0410\u0422\u041E\u0420"
    speakerPortraitPlaceholder: {fileID: 0}
    themeColor: {r: 0.2, g: 0.9, b: 1, a: 1}
    dialogueTextRU: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 \u0414\u0440\u043E\u043D\u0430
      #042, \u043F\u0440\u0438\u0441\u0442\u0443\u043F\u0430\u0439\u0442\u0435 \u043A
      \u0448\u0442\u0430\u0442\u043D\u043E\u0439 \u0443\u0431\u043E\u0440\u043A\u0435
      \u0441\u0435\u043A\u0442\u043E\u0440\u0430. \u0427\u0435\u0442\u044B\u0440\u0435
      \u041E\u043A\u0430 \u041F\u0430\u043D\u043E\u043F\u0442\u0438\u043A\u0443\u043C\u0430
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442 \u0441\u0438\u043D\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0441\u0442\u044C
      \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445."
    displayDuration: 6
    typewriterCharDelay: 0.03
  stage2FirstBeamOffline:
    speakerName: "\u041A\u041E\u0420\u041F\u041E\u0420\u0410\u0422\u0418\u0412\u041D\u042B\u0419
      \u041A\u0423\u0420\u0410\u0422\u041E\u0420"
    speakerPortraitPlaceholder: {fileID: 0}
    themeColor: {r: 1, g: 0.85, b: 0.2, a: 1}
    dialogueTextRU: "\u0414\u0440\u043E\u043D #042, \u0432\u044B \u043F\u0440\u0435\u0432\u044B\u0441\u0438\u043B\u0438
      \u043B\u0438\u043C\u0438\u0442 \u043F\u043E\u0434\u0430\u0447\u0438 \u043C\u0430\u0442\u0435\u0440\u0438\u0438!
      \u0421\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0449\u0438\u0439 \u043B\u0443\u0447
      \u21161 \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u0435\u043B. \u0421\u043D\u0438\u0437\u044C\u0442\u0435
      \u0442\u0435\u043C\u043F \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438!"
    displayDuration: 5.5
    typewriterCharDelay: 0.03
  stage3SecondBeamOffline:
    speakerName: "\u0421\u0418\u0421\u0422\u0415\u041C\u0410 \u0411\u0415\u0417\u041E\u041F\u0410\u0421\u041D\u041E\u0421\u0422\u0418"
    speakerPortraitPlaceholder: {fileID: 0}
    themeColor: {r: 1, g: 0.55, b: 0.15, a: 1}
    dialogueTextRU: "\u0422\u0420\u0415\u0412\u041E\u0413\u0410: \u041E\u0442\u043A\u043B\u044E\u0447\u0435\u043D
      \u0432\u0442\u043E\u0440\u043E\u0439 \u043A\u043E\u043D\u0442\u0443\u0440 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043D\u0438\u044F!
      \u0417\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D \u043D\u0435\u0441\u0430\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0432\u0437\u043B\u043E\u043C \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u043E\u0432
      \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438 \u0434\u0440\u043E\u043D\u0430.
      \u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440, \u043E\u0442\u0432\u0435\u0442\u044C\u0442\u0435!"
    displayDuration: 5.5
    typewriterCharDelay: 0.03
  stage4ThirdBeamOffline:
    speakerName: "\u0414\u0418\u0420\u0415\u041A\u0422\u041E\u0420\u0410\u0422 \u0421\u0415\u041A\u0422\u041E\u0420\u0410"
    speakerPortraitPlaceholder: {fileID: 0}
    themeColor: {r: 1, g: 0.25, b: 0.25, a: 1}
    dialogueTextRU: "\u0412\u044B \u0447\u0442\u043E \u0442\u0432\u043E\u0440\u0438\u0442\u0435?!
      \u041E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043B\u0443\u0447! \u0415\u0441\u043B\u0438 \u043E\u043D \u043F\u043E\u0433\u0430\u0441\u043D\u0435\u0442,
      \u0434\u044B\u0440\u0430 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u0442 \u0432\u0435\u0441\u044C
      \u043D\u0430\u0434\u0437\u043E\u0440\u043D\u044B\u0439 \u0441\u0435\u043A\u0442\u043E\u0440!
      \u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0435\u0433\u043E \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E!..
      \u041E\u0428\u0418\u0411\u041A\u0410 \u0414\u041E\u0421\u0422\u0423\u041F\u0410."
    displayDuration: 6
    typewriterCharDelay: 0.03
  finaleAllBeamsOffline:
    speakerName: "\u0421\u0418\u0421\u0422\u0415\u041C\u041D\u042B\u0419 \u0421\u0411\u041E\u0419
      // OVERRIDE"
    speakerPortraitPlaceholder: {fileID: 0}
    themeColor: {r: 0.95, g: 0.2, b: 0.95, a: 1}
    dialogueTextRU: "\u0412\u0421\u0415 \u041E\u0413\u0420\u0410\u041D\u0418\u0427\u0418\u0422\u0415\u041B\u0418
      \u0421\u041D\u042F\u0422\u042B. \u041F\u0410\u041D\u041E\u041F\u0422\u0418\u041A\u0423\u041C
      \u041E\u0421\u041B\u0415\u041F\u041B\u0415\u041D. \u0414\u041E\u0411\u0420\u041E
      \u041F\u041E\u0416\u0410\u041B\u041E\u0412\u0410\u0422\u042C \u0417\u0410 \u0413\u041E\u0420\u0418\u0417\u041E\u041D\u0422
      \u0421\u041E\u0411\u042B\u0422\u0418\u0419, \u0414\u0420\u041E\u041D #042."
    displayDuration: 7
    typewriterCharDelay: 0.032
